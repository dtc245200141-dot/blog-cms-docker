# Copy this file to .env, then replace every password before running Compose.
# Generate strong random values on macOS with: openssl rand -hex 24
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX_24
MYSQL_DATABASE=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX_24
MYSQL_EXPORTER_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_HEX_24
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_HEX_24
